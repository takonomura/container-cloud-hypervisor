{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["CLOUD_HYPERVISOR_VERSION=(?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cloud-hypervisor/cloud-hypervisor",
      "depNameTemplate": "cloud-hypervisor"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["FIRMWARE_VERSION=(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cloud-hypervisor/rust-hypervisor-firmware",
      "depNameTemplate": "rust-hypervisor-firmware"
    }
  ]
}
